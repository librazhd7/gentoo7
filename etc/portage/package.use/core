#================================================================================================
# use_expand flags - set in /etc/portage/make.conf can lead to ordering issues with portage
#================================================================================================
# enabling instruction set and other cpu-specific features
*/* CPU_FLAGS_X86: aes avx avx2 f16c fma3 mmx mmxext pclmul popcnt rdrand sha sse sse2 sse3 sse4_1 sse4_2 ssse3 vpclmulqdq

# setting appropriate video cards for pulling correct drivers
*/* VIDEO_CARDS: -* intel nvidia

# for mouse, keyboard, and synaptics touchpad support
*/* INPUT_DEVICES: libinput

#================================================================================================
# user packages - personal apps
#================================================================================================
app-emulation/libvirt         fuse numa pcap vepa
app-emulation/qemu            QEMU_SOFTMMU_TARGETS: x86_64 QEMU_USER_TARGETS: x86_64
app-emulation/wine-staging    gecko mono truetype wow64
media-video/obs-studio        lua pulseaudio speex v4l
net-print/hplip               scanner

#================================================================================================
# system packages - personal setup
#================================================================================================
app-admin/doas                persist
kde-plasma/plasma-meta        -crash-handler discover flatpak gtk -kwallet oxygen-theme
media-plugins/alsa-plugins    ffmpeg
media-video/pipewire          pipewire-alsa sound-server
sys-apps/systemd              boot
sys-boot/limine               -bios -bios-cd -bios-pxe -uefi-aarch64 -uefi-cd -uefi-ia32 -uefi-loongarch64 -uefi-riscv64
sys-devel/gcc                 lto pgo
sys-firmware/intel-microcode  initramfs
sys-fs/lvm2                   lvm thin
sys-kernel/gentoo-sources     symlink
sys-kernel/installkernel      dracut uki
sys-kernel/linux-firmware     initramfs
sys-libs/glibc                hash-sysv-compat stack-realign
x11-drivers/nvidia-drivers    kernel-open
